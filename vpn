#!/bin/bash
# tun0 VPN, user side: OpenVPN profiles in NetworkManager named <provider>-<country> (proton-ch, mullvad-ch, ...),
# with an nftables kill switch and a reconnect watchdog (root side: /usr/local/bin/vpn-root, password-less via sudoers).
#
#   vpn on [NAME|COUNTRY]  connect (no argument: default); COUNTRY alone = <provider of default>-COUNTRY; switches without a gap
#   vpn off                disconnect; releases the network you are on (until you change network)
#   vpn toggle             on (default) or off
#   vpn status             state + public IP + country/city/provider as seen by ipinfo.io
#   vpn list               profiles (* active, = default)
#   vpn default [NAME]     show / set the default (/etc/vpn/settings, written through vpn-root)
#   vpn add [FILE]         add a profile - gum wizard (file / clipboard / path, name, credentials); from the menu in a floating terminal
#   vpn remove [NAME]      remove a profile (without NAME: pick from menu)
#   vpn killswitch [on|off|toggle]   show / set the kill switch setting (default on; off = VPN without blocking, e.g. for LAN printers)
#   vpn trust [add|remove|edit] [SSID]   trusted Wi-Fi networks (default: the one you are on; edit = TUI); vpn autoconnect|autodisconnect [on|off|toggle]
#                          the list and both switches live in /etc/vpn: the dispatcher applies them as root, at pre-up, before login
#   vpn menu               open the Omarchy menu (predecessor of the panel); vpn recent = last used profiles
#   vpn version            the version of the installed plugin, read from its manifest.json
#   vpn menu-write | indicator | auto   internal: menu block, bar JSON (polled every 5 s); auto turns the dispatcher's last decision into a toast
#   vpn is-on | is-wanted | is-active NAME | is-default NAME     conditions for the menu (exit code)
# Full documentation: README.md in this repository.
set -uo pipefail
KS=/usr/local/bin/vpn-root
MARK=/run/vpn-killswitch.active
CFG_DIR=$HOME/.config/vpn              # only `recent` lives here; the policy state is root's (below)
MENU_FILE=$HOME/.config/omarchy/extensions/omarchy-menu.jsonc
PLUGIN_ID=rogertobler.tun0-vpn
PLUGIN_DIR=$HOME/.config/omarchy/plugins/$PLUGIN_ID
# Policy state belongs to root: the dispatcher decides at pre-up, before login, and must not read a home
# directory. All of it is world-readable, so the poll never needs sudo; writing goes through vpn-root.
SETTINGS_FILE=/etc/vpn/settings        # autoconnect=on|off, autodisconnect=on|off, default=<profile>, killswitch=on|off
TRUSTED_FILE=/etc/vpn/trusted          # trusted Wi-Fi networks, one SSID per line
OPEN_FILE=/run/vpn-killswitch.open     # exists = the kill switch table is loaded; contents = the interfaces allowed past it
EVENT_FILE=/run/vpn-killswitch.event   # the dispatcher's last automatic decision: epoch, kind, SSID, profile
RECENT_FILE=$CFG_DIR/recent            # most recently used profiles, newest first, at most 5
AUTO_STATE=${XDG_RUNTIME_DIR:-/tmp}/vpn-auto   # the event that was already turned into a toast
SELF=$(readlink -f "$0")

CONF_DIR=/etc/vpn/configs

ks()       { sudo -n "$KS" "$@"; }
ks_setting() { user_setting killswitch; }   # empty = on
uplink() { nmcli -t -f TYPE,DEVICE con show --active 2>/dev/null | awk -F: '$1!="vpn" && $1!="loopback" && $1!="tun" && $2!="" {print $2; exit}'; }
# on = the uplink is shut and only the tunnel may carry traffic (a VPN is wanted, or untrusted Wi-Fi with auto-connect on);
# off = the uplink is open; disabled = the setting is off, no table. Read from root's state file - no sudo on a poll.
# unloaded = the setting is on but no table is loaded (no profile yet, or the unit was stopped): nothing is blocked.
ks_state() {
  local up
  if [[ "$(ks_setting)" == "off" ]]; then echo "disabled"
  elif [[ ! -e "$OPEN_FILE" ]]; then echo "unloaded"
  else up=$(uplink); if [[ -n "$up" ]] && ! grep -qxF -- "$up" "$OPEN_FILE" 2>/dev/null; then echo "on"; else echo "off"; fi; fi
}
# notify [-u urgency] HEADLINE [TEXT] [--exec CMD ARGS...]  -> Omarchy-styled toast, optional action button
# VPN_QUIET=1 (set by the panel while it is open) drops the normal toasts - the panel shows the result
# itself, a toast on top of it only covers it. Critical ones still get through: they report a state the
# panel cannot show (rules failed to load, kill switch stuck) and may arrive after the panel is closed.
notify() {
  local u=normal; if [[ "${1:-}" == "-u" ]]; then u=$2; shift 2; fi
  [[ -n "${VPN_QUIET:-}" && "$u" != critical ]] && return 0
  omarchy-notification-send --app-name VPN -g "󰦝" -u "$u" "$@" 2>/dev/null || true
}
die_unknown() { echo "Unknown: '$1'. Available: $(connections | paste -sd' ')" >&2; exit 1; }
# Visible error inside the gum wizards - a plain echo scrolls past unnoticed between the styled prompts.
err() { gum style --foreground 1 "$*" 2>/dev/null || printf '%s\n' "$*" >&2; }

# The wizards run in a floating terminal. Omarchy's own wrapper prints the Omarchy logo there;
# this is the plugin's window, so it prints the plugin's name in the same block font (figlet
# "Delta Corps Priest 1", the family of Omarchy's logo.txt - the font has no digits, the zero is
# drawn by hand). Green through the plain ANSI code, so it follows the terminal theme like Omarchy's.
logo() {
