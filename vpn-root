#!/bin/bash -p
# tun0 VPN, the root side of `vpn`: kill switch, reconnect watchdog, trusted networks, settings and profile management.
# Called without a password through /etc/sudoers.d/vpn, in the forms listed there, which is why nothing needs a terminal.
#
# The kill switch is one nftables table, loaded at boot (vpn-killswitch.service) and kept for good. It drops
# everything that does not leave through the tunnel, except the handshake to the VPN servers, DHCP and
# loopback, and except the interfaces in its `open` set. That set is the whole policy: an interface is open
# when it is wired, when its Wi-Fi is trusted, or when the user released it with `vpn off`; it is closed
# whenever a VPN is wanted (the marker) or the Wi-Fi is untrusted and auto-connect is on. The NetworkManager
# dispatcher calls `netevent` at pre-up, before the interface is usable, so an untrusted network is shut
# before its first packet, also before anyone is logged in. Closed is the default; events only open.
#
#   boot                 load the table (unit ExecStart); a no-op while the kill switch setting is off or no profile exists
#   unload               delete the table (unit ExecStop): the emergency exit next to `vpn killswitch off`
#   netevent ACTION IFACE [UUID]   dispatcher: apply the policy to one interface (pre-up | up | pre-down | down)
#   sync [--connect]     apply the policy to every active interface; --connect also starts the tunnel when one is wanted
#   on [NAME]            a VPN is wanted (dispatcher vpn-up): write NAME to the marker, close the uplinks
#   arm NAME             the user asked for NAME: marker, remember this network as manually chosen, close the uplinks
#   off                  the user wants no VPN: delete the marker, release the network you are on until you change
#                        network, stop the watchdog, open the uplinks
#   status               on|off|disabled: is the uplink shut right now? (re-loads a missing table while the setting is on)
#   watch [DELAY]        start the watchdog as a transient systemd unit (idempotent)
#   unwatch              stop the watchdog (marker and kill switch stay)
#   reconnect [DELAY]    the watchdog loop itself (runs inside the unit)
#   trust add|remove SSID | trust set   the trusted Wi-Fi list (/etc/vpn/trusted; `set` reads the whole list on stdin)
#   get KEY              read a setting (/etc/vpn/settings): killswitch (default on), autoconnect, autodisconnect, default
#   set KEY VALUE        write a setting and apply it: killswitch on|off loads or removes the table at once, the others re-run the policy
#   auth PROV            store the credentials of a provider (two lines on stdin: username, password) in /etc/vpn/auth/PROV
#   add NAME             the .ovpn on stdin to /etc/vpn/configs/NAME.ovpn, re-render the kill switch, import
#                        NetworkManager profile NAME (the credentials of its provider must be stored already)
#   remove NAME          delete profile and config (last profile of a provider: its credentials too), re-render the kill switch
#   rebuild [NAME]       render the kill switch from every config (+ reload it if loaded); re-import NAME or all profiles
#   has-auth PROV        exit 0 if credentials for that provider are stored
#
# Every argument is checked against a fixed form before it is used, here and again in /etc/sudoers.d/vpn, which
# lets the user side call only the verbs it needs. Root never opens a path its caller names: a config and
# credentials arrive as bytes on stdin.
set -euo pipefail
# Tools are found through this PATH only, never through the caller's: sudo keeps the caller's PATH on a system
# without secure_path, and a helper that runs as root without a password must not pick up a program the caller put
# in front of the real one.
export PATH=/usr/bin LC_ALL=C   # and never the caller's locale, which sudo passes on
umask 022
ETC=/etc/vpn; CONF=$ETC/configs; AUTHD=$ETC/auth
MAX_CONFIG=1048576              # bytes; a country config of every server of a provider is a few kilobytes
MAX_PROFILES=64                 # configs in /etc/vpn/configs
MAX_ENDPOINTS=4096              # server address and port pairs in the kill switch
MAX_SSID=128                    # bytes of one trusted network name (a real SSID has at most 32)
MAX_TRUSTED=1024                # names in the trusted list
RULES=$ETC/killswitch.nft; TEMPLATE=$ETC/killswitch.nft.in
TABLE="inet vpn_ks"
SETTINGS=$ETC/settings          # killswitch=on|off (default on), autoconnect=on|off, autodisconnect=on|off, default=<profile>
TRUSTED=$ETC/trusted            # trusted Wi-Fi networks, one SSID per line
MARK=/run/vpn-killswitch.active      # exists = "a VPN is wanted"; contents = the wanted connection. World-readable
OPEN=/run/vpn-killswitch.open        # exists = the table is loaded; contents = the open interfaces, one per line. World-readable
MANUAL=/run/vpn-killswitch.manual    # the SSID on which the user last said on or off by hand: no automatics there until the network changes
EVENT=/run/vpn-killswitch.event      # the last automatic decision (epoch, kind, SSID, profile); the user side turns it into a toast
UNIT=vpn-reconnect

# The fixed forms of every argument. A value that does not fit is refused, never repaired.
valid_name()  { [[ "${1:-}" =~ ^[a-z0-9]+-[a-z0-9]+$ ]]; }                  # a profile: <provider>-<country>, also a path piece
valid_prov()  { [[ "${1:-}" =~ ^[a-z0-9]+$ ]]; }
valid_iface() { [[ "${1:-}" =~ ^[A-Za-z0-9_.-]{1,15}$ ]]; }                 # a kernel interface name; it is written into an nft batch
valid_uuid()  { [[ "${1:-}" =~ ^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$ || "${1:-}" =~ ^[0-9A-Fa-f]{40}$ ]]; }   # the usual form, or the older 40-hex one NetworkManager still accepts
valid_type()  { [[ "${1:-}" =~ ^[a-z0-9-]{1,40}$ ]]; }                     # a NetworkManager connection type
valid_delay() { [[ "${1:-}" =~ ^[0-9]{1,3}$ ]]; }
managed() { valid_name "${1:-}" && [[ -f "$CONF/$1.ovpn" ]]; }   # only profiles we imported; foreign NM VPNs are none of our business
log() { logger -t vpn-root "$*" 2>/dev/null || true; }   # a missing journal must never abort a policy decision

get_setting() { local v; v=$(grep -s "^$1=" "$SETTINGS" | tail -1 | cut -d= -f2- || true); case "$1" in killswitch) echo "${v:-on}" ;; *) echo "$v" ;; esac; }
put_setting() {
  install -d -m755 "$ETC"
  { grep -sv "^$1=" "$SETTINGS" || true; echo "$1=$2"; } > "$SETTINGS.tmp" && mv "$SETTINGS.tmp" "$SETTINGS"; chmod 644 "$SETTINGS"
}
# An SSID is 32 arbitrary bytes and may contain a newline. `grep -F` reads a multi-line pattern as a LIST of
# patterns, so "Hotel WiFi\nHome" would count as trusted if Home is. So a name with a newline counts as no name at
# all: ssid_of returns nothing, is_trusted refuses, and the verdict shuts.
is_trusted() { [[ -n "${1:-}" && "$1" != *$'\n'* ]] && grep -qxF -- "$1" "$TRUSTED" 2>/dev/null; }
ssid_of() {   # by UUID or name; empty for wired, empty for a name that does not fit on one line
  local s; [[ -n "${1:-}" ]] || return 0
  s=$(nmcli -g 802-11-wireless.ssid con show "$1" 2>/dev/null | sed 's/\\:/:/g' || true)
  if [[ "$s" == *$'\n'* ]]; then log "$1: SSID contains a line break, treated as unnamed (shut)"; return 0; fi
  printf '%s' "$s"
}
# The interfaces that carry traffic to the outside: every active connection that is not a VPN and not loopback.
# One line each: IFACE<TAB>UUID<TAB>TYPE. Activating ones are included: that is the pre-up moment. An interface whose
# name does not fit valid_iface is left out, so it is never opened.
uplinks()    { nmcli -t -f DEVICE,UUID,TYPE con show --active 2>/dev/null | awk -F: '$1!="" && $3!="vpn" && $3!="loopback" && !($3=="tun" && $1 ~ /^tun[0-9]+$/) && $1 ~ /^[A-Za-z0-9_.-]+$/ && length($1) <= 15 {print $1 "\t" $2 "\t" $3}'; }   # tunN is the tunnel itself; other tun devices (tailscale0, tap0) are uplinks
first_managed() { local f; for f in "$CONF"/*.ovpn; do [[ -f "$f" ]] && { basename "$f" .ovpn; return 0; }; done; return 1; }
current_ssid() { local l; while IFS=$'\t' read -r i u t; do [[ "$t" == 802-11-wireless ]] && { ssid_of "$u"; return 0; }; done < <(uplinks); return 0; }
table_loaded() { nft list table $TABLE &>/dev/null; }
event() { printf '%s\t%s\t%s\t%s\n' "$(date +%s%N)" "$1" "$2" "${3:-}" > "$EVENT"; chmod 644 "$EVENT"; }
managed_up()   { local n; for n in $(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="vpn"{print $1}'); do managed "$n" && return 0; done; return 1; }   # one of our tunnels is up or coming up
managed_active() { local n t st; while IFS=: read -r n t st; do [[ "$t" == vpn && "$st" == activated ]] && managed "$n" && { echo "$n"; return 0; }; done < <(nmcli -t -f NAME,TYPE,STATE con show --active 2>/dev/null); return 1; }   # ... and really up: prints its name
wifi_uplink()  { local i u t; while IFS=$'\t' read -r i u t; do [[ "$t" == 802-11-wireless ]] && return 0; done < <(uplinks); return 1; }
tunnels_down() {   # -w 0: this may run inside a dispatcher script, which must not wait for NM
  local n u t list
  list=$(nmcli -t -f NAME,UUID,TYPE con show --active 2>/dev/null) || true
  while IFS=: read -r n u t; do
    [[ "$t" == vpn ]] && valid_uuid "$u" && managed "$n" && { nmcli -w 0 con down uuid "$u" >/dev/null 2>&1 || true; }
  done <<<"$list"
}
# vpn_uuid NAME: the UUID of our VPN connection of that name. A connection is brought up and down by its UUID, never by
# its name, which another connection (a Wi-Fi called proton-ch) may carry too.
vpn_uuid() { nmcli -t -f NAME,UUID,TYPE con show 2>/dev/null | awk -F: -v n="$1" '$1 == n && $3 == "vpn" {print $2; exit}'; }

# verdict IFACE UUID TYPE -> open|closed. Pure: reads the state, changes nothing.
verdict() {
  local ssid=""
  [[ -e "$MARK" ]] && { echo closed; return; }            # a VPN is wanted: only the tunnel may carry traffic
  [[ "$3" == 802-11-wireless ]] || { echo open; return; }   # wired, and anything else that is not Wi-Fi: left alone
  ssid=$(ssid_of "$2")
  [[ -n "$ssid" ]] || { [[ "$(cat "$MANUAL" 2>/dev/null || true)" == "*" ]] && echo open || echo closed; return; }   # a Wi-Fi we cannot name is not one we trust, unless the user released it (`vpn off` writes "*" there)
  is_trusted "$ssid" && { echo open; return; }
  [[ "$(cat "$MANUAL" 2>/dev/null || true)" == "$ssid" ]] && { echo open; return; }   # released by hand (`vpn off`) on this very network
  [[ "$(get_setting autoconnect)" == on ]] && first_managed >/dev/null && { echo closed; return; }   # untrusted, VPN wanted by policy, and a profile exists to honour it; with no profile at all the policy cannot be met, so the user is not stranded
  echo open
}
# decide IFACE UUID TYPE PHASE -> open|closed. The automatics first (they may write or delete the marker), then the verdict.
# PHASE pre-up: NetworkManager is waiting for us, so nothing slow and no nmcli that changes state.
decide() {
  local iface=$1 uuid=$2 type=$3 phase=${4:-sync} ssid="" man def
  if [[ "$type" == 802-11-wireless ]]; then
    ssid=$(ssid_of "$uuid")
    man=$(cat "$MANUAL" 2>/dev/null || true)
    if [[ -n "$ssid" && -n "$man" && "$man" != "$ssid" ]]; then rm -f "$MANUAL"; man=""; fi   # a manual choice lasts for one network
    if [[ -n "$ssid" && "$man" != "$ssid" ]]; then
      if is_trusted "$ssid"; then
        if [[ "$(get_setting autodisconnect)" == on ]]; then
          if [[ -e "$MARK" ]]; then
            rm -f "$MARK"; systemctl stop "$UNIT.service" 2>/dev/null || true
            event disconnect "$ssid"; log "$iface \"$ssid\" trusted: auto-disconnect, network released"
          fi
          # The tunnel itself comes down at `up`, not at pre-up (NetworkManager is waiting for us there). By then
          # the marker is already gone (pre-up removed it), so the test is "a managed tunnel is still up on a
          # trusted network that wants none", not "the marker is there". Otherwise the marker goes, the interface
          # opens, and the tunnel stays connected the whole time on the trusted network.
          if [[ "$phase" != pre-up ]] && managed_up; then
            tunnels_down; log "$iface \"$ssid\" trusted: tunnel brought down"
          fi
        fi
      elif [[ ! -e "$MARK" && "$(get_setting autoconnect)" == on ]]; then
        def=$(get_setting default); managed "$def" || def=$(first_managed || true)   # same election as the user side: the first profile
        if managed "$def"; then echo "$def" > "$MARK"; event connect "$ssid" "$def"; log "$iface \"$ssid\" untrusted: auto-connect $def, interface stays shut"
        else event noprofile "$ssid"; log "$iface \"$ssid\" untrusted, auto-connect on, but no profile at all: nothing to connect, interface left open"; fi
      fi
    fi
  fi
  verdict "$iface" "$uuid" "$type"
}

# Render the open set into the table, atomically (one nft batch): flush, then add what is open now.
apply_open() {   # reads IFACE names on stdin
  local list; list=$(awk 'NF' | sort -u)
  table_loaded || return 0   # nothing to apply without a table (setting off, or no profile yet)
  # `if`, not `[[ ]] &&`: a false test as the last command of this group would fail the pipeline under
  # pipefail, set -e would end the subshell, and the state file below would never be written.
  { echo "flush set $TABLE open"
    if [[ -n "$list" ]]; then printf 'add element %s open { %s }\n' "$TABLE" "$(printf '"%s"' $list | sed 's/""/", "/g')"; fi
  } | nft -f -
  printf '%s\n' "$list" > "$OPEN.tmp"; chmod 644 "$OPEN.tmp"; mv "$OPEN.tmp" "$OPEN"
}
# sync [--connect] [--phase PHASE] [--shut IFACE] [IFACE UUID TYPE]: run decide over every uplink (the given one
# overrides or is added; at pre-up NetworkManager may not list it yet), write the open set, and with --connect
# start the watchdog when a VPN is wanted and none is up. --shut IFACE takes that interface out no matter what
# nmcli says: at pre-down and down the connection is still listed while it goes away, and the next network
# gets its address before pre-up runs; a stale entry would be open for exactly those milliseconds.
# Never --connect from `arm`: the user's own `nmcli con up` is already on its way, and two connects racing each
# other leave the machine without network.
sync() {
  local connect=0 phase=sync i u t v seen="" opened=""
  while [[ $# -gt 0 ]]; do case "$1" in
    --connect) connect=1; shift ;;
    --phase)   [[ "${2:-}" =~ ^(pre-up|up|sync)$ ]] || { echo "sync: --phase pre-up|up|sync" >&2; return 2; }; phase=$2; shift 2 ;;
    --shut)    valid_iface "${2:-}" || { echo "sync: --shut IFACE" >&2; return 2; }; seen=$2; log "$2 -> closed (going down)"; shift 2 ;;
    *) break ;;
  esac; done
  if [[ $# -ne 0 ]] && ! { [[ $# -eq 3 ]] && valid_iface "$1" && valid_uuid "$2" && valid_type "$3"; }; then
    echo "sync [--connect] [--phase PHASE] [--shut IFACE] [IFACE UUID TYPE]" >&2; return 2
  fi
  # Self-heal: the setting says on, rules exist, the unit is not stopped on purpose, and yet no table: reload it
  # (a flushed ruleset, or a first profile added after boot). Behind `systemctl stop vpn-killswitch` this stays off.
  if [[ "$(get_setting killswitch)" != off && -s "$RULES" ]] && ! table_loaded && systemctl is-active -q vpn-killswitch.service 2>/dev/null; then load_rules || true; fi
  if [[ $# -eq 3 ]]; then v=$(decide "$1" "$2" "$3" "$phase"); seen="$1"; [[ "$v" == open ]] && opened+="$1"$'\n'; log "$1 -> $v"; fi
  while IFS=$'\t' read -r i u t; do
    [[ -n "$i" && "$i" != "$seen" ]] || continue
    v=$(decide "$i" "$u" "$t" "$phase"); [[ "$v" == open ]] && opened+="$i"$'\n'
  done < <(uplinks)
  printf '%s' "$opened" | apply_open
  if (( connect )) && [[ -e "$MARK" && "$phase" != pre-up ]] && ! managed_up; then   # ours only: a foreign NM VPN is none of our business
    /usr/local/bin/vpn-root watch 0   # by path, not "$0": run by sudo through a checked digest, $0 is /dev/fd/N
  fi
}

load_rules() {   # respects the killswitch setting; renders the open set from the current verdicts, so a reload never shuts an open uplink
  if [[ "$(get_setting killswitch)" == "off" ]]; then
    table_loaded && nft delete table $TABLE; rm -f "$OPEN"; return 0
  fi
  [[ -s "$RULES" ]] || { echo "No kill switch rules ($RULES). Add a profile first" >&2; return 1; }
  local i u t list="" el="" tmp
  while IFS=$'\t' read -r i u t; do [[ -n "$i" && "$(verdict "$i" "$u" "$t")" == open ]] && list+="$i"$'\n'; done < <(uplinks)
  list=$(printf '%s' "$list" | awk 'NF' | sort -u)
  if [[ -n "$list" ]]; then el="elements = { $(printf '"%s"' $list | sed 's/""/", "/g') }"; fi
  tmp=$(mktemp /run/.vpn-ks.XXXXXX)
  sed "s|@OPEN_ELEMENTS@|$el|" "$RULES" > "$tmp"
  nft -f "$tmp"; rm -f "$tmp"
  printf '%s\n' "$list" > "$OPEN.tmp"; chmod 644 "$OPEN.tmp"; mv "$OPEN.tmp" "$OPEN"
}

render_rules() {
  # The handshake exception is a set of server address and port pairs per protocol, taken from every config:
  # `remote HOST [PORT [PROTO]]`, where PORT defaults to the config's `port`/`rport` or 1194 and PROTO to its `proto`
  # or udp. Host names are resolved now. A pair lets exactly that server on that port through, not any listed port.
  local configs=("$CONF"/*.ovpn) pairs udp tcp n tmp
  [[ -f "${configs[0]}" ]] || { rm -f "$RULES"; echo "No configs in $CONF, kill switch rules removed" >&2; return; }
  pairs=$(for c in "${configs[@]}"; do
    awk '{ sub(/\r$/, "") }
      $1 == "proto" { dproto = ($2 ~ /^tcp/) ? "tcp" : "udp" }
      $1 == "port" || $1 == "rport" { if ($2 ~ /^[0-9]+$/) dport = $2 }
      $1 == "remote" { host[++n] = $2; port[n] = $3; proto[n] = $4 }
      END { if (!dproto) dproto = "udp"; if (!dport) dport = 1194
        for (i = 1; i <= n; i++) print ((proto[i] ~ /^tcp/) ? "tcp" : (proto[i] ~ /^udp/) ? "udp" : dproto), host[i], (port[i] ~ /^[0-9]+$/ ? port[i] : dport) }' "$c"
  done | sort -u | while read -r pr h po; do
    (( po >= 1 && po <= 65535 )) || continue
    if [[ "$h" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then echo "$pr $h $po"
    else getent ahostsv4 -- "$h" 2>/dev/null | awk -v pr="$pr" -v po="$po" '{print pr, $1, po}' | sort -u | grep . || echo "warning: cannot resolve $h now, so it stays out of the kill switch until the next rebuild" >&2
    fi
  done | sort -u)
  [[ -n "$pairs" ]] || { echo "No resolvable server address in any config" >&2; return 1; }
  n=$(grep -c . <<<"$pairs")
  (( n <= MAX_ENDPOINTS )) || { echo "$n server endpoints, more than $MAX_ENDPOINTS; keeping the previous $RULES" >&2; return 1; }
  udp=$(awk '$1 == "udp" {printf "%s%s . %s", (k++ ? ", " : ""), $2, $3}' <<<"$pairs")
  tcp=$(awk '$1 == "tcp" {printf "%s%s . %s", (k++ ? ", " : ""), $2, $3}' <<<"$pairs")
  # An empty set takes no elements line at all. Built here, not inside ${var:+...}: the first } would end that expansion.
  [[ -z "$udp" ]] || udp="elements = { $udp }"
  [[ -z "$tcp" ]] || tcp="elements = { $tcp }"
  tmp=$(mktemp "$ETC/.killswitch.XXXXXX")
  # @OPEN_ELEMENTS@ stays in the rendered file (filled at load time); the syntax check runs on a copy without it
  if ! sed -e "s|@UDP_ELEMENTS@|$udp|" -e "s|@TCP_ELEMENTS@|$tcp|" "$TEMPLATE" > "$tmp" \
     || ! sed 's|@OPEN_ELEMENTS@||' "$tmp" | nft -c -f -; then
    rm -f "$tmp"; echo "Rendered rules are invalid; keeping the previous $RULES" >&2; return 1
  fi
  chmod 644 "$tmp"; mv "$tmp" "$RULES"
  echo "Kill switch: $n server endpoints ($(awk '$1=="udp"' <<<"$pairs" | wc -l) UDP, $(awk '$1=="tcp"' <<<"$pairs" | wc -l) TCP)"
  [[ -e "$OPEN" ]] && { load_rules; echo "Kill switch reloaded"; } || true
}

# config_problem FILE: prints why a config must not reach NetworkManager's importer, nothing when it may.
# The importer runs as root here. It keeps a file path for ca, cert, key, pkcs12, tls-auth, tls-crypt, tls-crypt-v2,
# crl-verify, secret and extra-certs and reads it later as root, and for http-proxy and socks-proxy it reads the
# credentials file right away into the connection, where its first line is visible to the user (measured with
# libnm-vpn-plugin-openvpn, NetworkManager 1.58). Scripts (up, down, plugin ...) it drops. It also splits a line at a
# carriage return or form feed where awk does not, so `ca<CR>/etc/shadow` would pass a check by fields: every control
# byte but tab and a line-ending CR is refused first. `[inline]` is no exception: the
# importer knows no such word and keeps it as a path.
# OpenVPN's hooks that run a program or load code. NetworkManager's importer drops them, and the openvpn command line
# NetworkManager builds never carries them: the imported connection is the same with and without them (measured
# with NetworkManager 1.58.1). They are removed from the copy that is imported anyway, so that nothing root runs rests
# on the importer of whichever NetworkManager is installed. Proton ships up and down lines.
SCRIPT_DIRECTIVES='up|down|route-up|route-pre-down|ipchange|tls-verify|auth-user-pass-verify|client-connect|client-disconnect|client-crresponse|learn-address|plugin|script-security|iproute'
without_scripts() {   # SRC DST
  LC_ALL=C awk -v re="^($SCRIPT_DIRECTIVES)\$" '{ sub(/\r$/, ""); d = $1; sub(/^--/, "", d); gsub(/["\047]/, "", d); d = tolower(d) }
    d ~ re { next } { print }' "$1" > "$2"
}
config_problem() {
  local f=$1 n bad
  n=$(LC_ALL=C sed 's/\r$//' "$f" | LC_ALL=C tr -d '\t\n\040-\176\200-\377' | wc -c)
  (( n == 0 )) || { echo "contains a control character (only tab and line ends are allowed)"; return 0; }
  bad=$(LC_ALL=C sed 's/\r$//' "$f" | awk '{ sub(/^[ \t]+/, ""); d = $1; sub(/^--/, "", d); d = tolower(d) }
    d ~ /^(ca|cert|key|pkcs12|tls-auth|tls-crypt|tls-crypt-v2|crl-verify|secret|extra-certs)$/ && NF >= 2 { print NR": "d; exit }
    d ~ /^(http-proxy|socks-proxy)$/ && NF >= 4 && $4 !~ /^(stdin|auto|auto-nct)$/ { print NR": "d; exit }
    d ~ /^(auth-user-pass|askpass)$/ && NF >= 2 && $2 != "stdin" { print NR": "d; exit }')
  [[ -z "$bad" ]] || echo "names a file for '${bad#*: }' (line ${bad%%:*}). Paste certificates and keys inline, as <ca>...</ca>; proxy credentials files are not supported"
}

# vpn_uuids NAME: the UUIDs of the NetworkManager VPN connections called NAME, one per line. Fails when a connection
# of that name is not a VPN: that one is somebody else's (a Wi-Fi called proton-ch), and nothing here touches it.
vpn_uuids() {
  local list
  list=$(nmcli -t -f NAME,UUID,TYPE con show 2>/dev/null) || return 1
  awk -F: -v n="$1" '$1 == n && $3 != "vpn" { bad = 1 } $1 == n && $3 == "vpn" { print $2 } END { exit bad }' <<<"$list" \
    || { echo "$1: a NetworkManager connection of that name exists and is not a VPN; it is left alone" >&2; return 1; }
}
# The credentials go to NetworkManager through libnm, read from stdin, never as arguments: an argument of nmcli is
# in the process list, which other users can read. Measured on NetworkManager
# 1.58: vpn.user-name, password-flags=0 and the secret read back exactly as `nmcli con mod` set them before.
NM_SET_CREDENTIALS='
import sys, gi
gi.require_version("NM", "1.0")
from gi.repository import NM, GLib
user = sys.stdin.readline().rstrip("\n"); password = sys.stdin.readline().rstrip("\n")
client = NM.Client.new(None)
con = client.get_connection_by_uuid(sys.argv[1])
if con is None or con.get_setting_vpn() is None:
    sys.exit("no VPN connection " + sys.argv[1])
vpn = con.get_setting_vpn()
vpn.set_property(NM.SETTING_VPN_USER_NAME, user)
vpn.add_data_item("password-flags", "0")
vpn.add_secret("password", password)
loop, failed = GLib.MainLoop(), []
def done(c, result, _):
    try:
        c.commit_changes_finish(result)
    except GLib.Error as e:
        failed.append(e.message)
    loop.quit()
con.commit_changes_async(True, None, done, None)
loop.run()
sys.exit(failed[0] if failed else 0)
'
import_profile() {
  # Every step returns on failure by itself: the callers run this inside `if !` and `||`, where set -e does not act,
  # and without the returns a failed import ended with the echo below and reported success.
  local name=$1 f=$CONF/$1.ovpn prov=${1%%-*} why old uuid out imp rc
  [[ -f "$AUTHD/$prov" ]] || { echo "Credentials missing: $AUTHD/$prov" >&2; return 1; }
  # A config stored before this check existed (1.0.0 took a path) is checked again before every import
  why=$(config_problem "$f"); [[ -z "$why" ]] || { echo "$name: the config $why" >&2; return 1; }
  old=$(vpn_uuids "$name") || return 1
  for uuid in $old; do nmcli con delete uuid "$uuid" >/dev/null || return 1; done
  # The copy without script hooks, in a directory only root can read; named NAME.ovpn, because the profile is named
  # after the file without .ovpn
  imp=$(mktemp -d /run/tun0-vpn-import.XXXXXX) || return 1
  without_scripts "$f" "$imp/$name.ovpn" || { rm -rf "$imp"; return 1; }
  out=$(nmcli con import type openvpn file "$imp/$name.ovpn"); rc=$?
  rm -rf "$imp"
  (( rc == 0 )) || return 1
  uuid=$(grep -oE '[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}' <<<"$out" | head -1)
  valid_uuid "$uuid" || { echo "$name: imported, but NetworkManager named no connection UUID" >&2; return 1; }
  nmcli con mod uuid "$uuid" connection.autoconnect no ipv4.dns-priority -1 \
    vpn.persistent yes +vpn.data "ping=10, ping-restart=60" \
    +vpn.data "mssfix=1400, tunnel-mtu=1400" || return 1   # a Wi-Fi path MTU can be below 1500 (measured 1438; Proton ships mssfix 0, which broke HTTPS)
  /usr/bin/python3 -I -c "$NM_SET_CREDENTIALS" "$uuid" < "$AUTHD/$prov" || return 1
  nmcli con mod uuid "$uuid" ipv6.method disabled 2>/dev/null || true
  echo "Profile: $name"
}

do_boot() {
  local n o
  [[ "$(get_setting killswitch)" != off ]] || { log "kill switch setting is off, table not loaded"; return 0; }
  [[ -s "$RULES" ]] || { log "no profile yet, kill switch not loaded (add one, then: vpn-root boot)"; return 0; }
  # A tunnel that is up while the table comes back (killswitch off -> on) is wanted: adopt it, or the uplink
  # would be rendered open beside a running tunnel, and a drop would leave it open with no watchdog.
  if [[ ! -e "$MARK" ]] && n=$(managed_active); then echo "$n" > "$MARK"; log "adopted the running tunnel $n"; fi
  load_rules; sync --connect
  o=$(paste -sd' ' "$OPEN" 2>/dev/null || true); log "kill switch loaded (open: ${o:-none})"
}
unload_table() { table_loaded && nft delete table $TABLE; rm -f "$OPEN"; }
do_unload() {   # the emergency exit (unit ExecStop): no VPN wanted any more, and nothing may reload the table behind it
  systemctl stop "$UNIT.service" 2>/dev/null || true; rm -f "$MARK"
  unload_table
  log "kill switch table removed, VPN no longer wanted"
}

# One decision at a time: the dispatcher, the watchdog and the user's own command may run concurrently, and a
# set computed from a state that changed underneath would be applied late. Long-running verbs stay outside.
LOCK=/run/vpn-killswitch.lock
case "${1:-}" in boot|unload|netevent|sync|on|arm|off|status|set|trust) exec 9>"$LOCK"; flock -w 5 9 || log "lock: waited 5 s, going ahead" ;; esac

case "${1:-}" in
  boot)
    do_boot
    ;;
  unload)
    do_unload
    ;;
  netevent)
    action=${2:-}; iface=${3:-}; uuid=${4:-}
    [[ -n "$iface" ]] || exit 0
    # A name that does not fit was never let into the open set, so there is nothing to shut, and nothing is opened for it
    valid_iface "$iface" || { log "netevent $action: not an interface name, ignored: $(printf '%q' "$iface")"; exit 0; }
    case "$action" in
      pre-down|down) sync --shut "$iface" ;;   # out of the set before the interface can carry the next network's first packet
      pre-up|up)
        valid_uuid "$uuid" || { log "netevent $action $iface: not a connection UUID, left shut: $(printf '%q' "$uuid")"; exit 0; }
        type=$(nmcli -g connection.type con show "$uuid" 2>/dev/null || true)
        [[ -n "$type" && "$type" != vpn && "$type" != loopback ]] || exit 0   # NM 1.58 dispatches lo as a connection too: nothing to decide there
        [[ "$type" == tun && "$iface" == tun[0-9]* ]] && exit 0   # the tunnel's own tun0 shows up as an external `tun` device: not an uplink (other tun devices are)
        if [[ "$action" == up ]]; then sync --connect --phase up "$iface" "$uuid" "$type"
        else sync --phase pre-up "$iface" "$uuid" "$type"; fi ;;
    esac
    ;;
  sync)
    sync "${@:2}"
    ;;
  on)
    if [[ -n "${2:-}" ]] && ! managed "$2"; then exit 0; fi   # the dispatcher fires for every NM VPN; foreign ones are ignored
    if [[ ! -e "$MARK" ]]; then s=$(current_ssid); if [[ -n "$s" ]]; then printf '%s\n' "$s" > "$MANUAL"; fi; fi   # nobody armed this tunnel: brought up by hand (nmcli), so no automatics on this network
    if [[ -n "${2:-}" ]]; then echo "$2" > "$MARK"; else [[ -e "$MARK" ]] || : > "$MARK"; fi
    [[ -e "$OPEN" ]] || ! systemctl is-active -q vpn-killswitch.service 2>/dev/null || load_rules || true   # belt and braces, but never behind `systemctl stop`
    sync
    log "kill switch $(get_setting killswitch)${2:+ ($2)}"
    ;;
  arm)
    managed "${2:-}" || { echo "arm NAME (a managed profile)" >&2; exit 1; }
    [[ -s "$RULES" || "$(get_setting killswitch)" == "off" ]] || { echo "No kill switch rules ($RULES). Run: vpn-root rebuild" >&2; exit 1; }
    echo "$2" > "$MARK"
    s=$(current_ssid); if [[ -n "$s" ]]; then printf '%s\n' "$s" > "$MANUAL"; else rm -f "$MANUAL"; fi
    [[ -e "$OPEN" ]] || ! systemctl is-active -q vpn-killswitch.service 2>/dev/null || load_rules || true
    sync
    ;;
  off)
    rm -f "$MARK"
    s=$(current_ssid)
    if [[ -n "$s" ]]; then printf '%s\n' "$s" > "$MANUAL"
    elif wifi_uplink; then printf '*\n' > "$MANUAL"   # a Wi-Fi we cannot name: released all the same, until a named network comes up
    else rm -f "$MANUAL"; fi
    systemctl stop "$UNIT.service" 2>/dev/null || true
    sync
    log "no VPN wanted, network released${s:+ (\"$s\", until the next network)}"
    ;;
  status)
    [[ "$(get_setting killswitch)" != off ]] || { echo disabled; exit 1; }
    if ! table_loaded && [[ -s "$RULES" ]] && systemctl is-active -q vpn-killswitch.service 2>/dev/null; then load_rules && sync && log "kill switch table was gone, restored"; fi
    table_loaded || { echo off; exit 1; }
    shut=0; while IFS=$'\t' read -r i u t; do [[ -n "$i" ]] && ! grep -qxF -- "$i" "$OPEN" 2>/dev/null && shut=1; done < <(uplinks)
    if (( shut )); then echo on; else echo off; exit 1; fi
    ;;
  get)
    [[ "${2:-}" =~ ^[a-z]+$ ]] || { echo "get KEY" >&2; exit 1; }   # KEY becomes a grep pattern
    get_setting "$2"
    ;;
  set)
    key=${2:-}; val=${3:-}
    case "$key=$val" in
      killswitch=on|killswitch=off|autoconnect=on|autoconnect=off|autodisconnect=on|autodisconnect=off) ;;
      default=*) [[ -z "$val" ]] || managed "$val" || { echo "default: '$val' is not a profile" >&2; exit 1; } ;;
      *) echo "set killswitch|autoconnect|autodisconnect on|off, set default NAME" >&2; exit 1 ;;
    esac
    put_setting "$key" "$val"
    log "setting $key=$val"
    case "$key=$val" in
      killswitch=off) unload_table; log "kill switch off: table removed, marker and watchdog untouched" ;;   # a printer needs the LAN, not a forgotten VPN
      killswitch=on)  do_boot ;;
      default=*)      sync --connect ;;                    # the target changed, the user's manual choice did not
      *)              rm -f "$MANUAL"; sync --connect ;;   # an automation switch flipped is a new intent: it takes effect right now, past a manual on/off on this network
    esac
    ;;
  trust)
    op=${2:-}; ssid=${3:-}
    install -d -m755 "$ETC"
    man=$(cat "$MANUAL" 2>/dev/null || true); before=0; if [[ -n "$man" ]] && is_trusted "$man"; then before=1; fi
    case "$op" in
      add|remove)
        [[ $# -eq 3 && -n "$ssid" && "$ssid" != *$'\n'* && ${#ssid} -le $MAX_SSID ]] || { echo "trust $op SSID (one line, at most $MAX_SSID bytes)" >&2; exit 1; }
        { grep -svxF -- "$ssid" "$TRUSTED" || true; if [[ "$op" == add ]]; then printf '%s\n' "$ssid"; fi; } > "$TRUSTED.tmp"
        # the same limit as trust set, or one add too many would leave a list that trust set (vpn trust edit) refuses
        (( $(wc -l < "$TRUSTED.tmp") <= MAX_TRUSTED )) || { rm -f "$TRUSTED.tmp"; echo "trust add: there are $MAX_TRUSTED trusted names already" >&2; exit 1; } ;;
      set)  [[ $# -eq 2 ]] || { echo "trust set: the list on stdin" >&2; exit 1; }
            # the whole list on stdin, one SSID per line; more than 64 KiB is refused, never cut (a cut line would be trusted)
            head -c 65537 > "$TRUSTED.tmp"
            (( $(stat -c %s "$TRUSTED.tmp") <= 65536 )) || { rm -f "$TRUSTED.tmp"; echo "trust set: the list is larger than 64 KiB" >&2; exit 1; }
            awk -v max="$MAX_SSID" 'length($0) > max { exit 1 }' "$TRUSTED.tmp" \
              || { rm -f "$TRUSTED.tmp"; echo "trust set: a name longer than $MAX_SSID bytes" >&2; exit 1; }
            awk 'NF && !seen[$0]++' "$TRUSTED.tmp" > "$TRUSTED.new" && mv "$TRUSTED.new" "$TRUSTED.tmp"
            (( $(wc -l < "$TRUSTED.tmp") <= MAX_TRUSTED )) || { rm -f "$TRUSTED.tmp"; echo "trust set: more than $MAX_TRUSTED names" >&2; exit 1; } ;;
      *)    echo "trust add|remove SSID, trust set (stdin)" >&2; exit 1 ;;
    esac
    chmod 644 "$TRUSTED.tmp"; mv "$TRUSTED.tmp" "$TRUSTED"
    log "trusted networks: $(paste -sd, "$TRUSTED" | sed 's/,/, /g')"
    # Changing the trust of THE network the user acted on by hand is a new intent there: the earlier `vpn off`
    # no longer pauses the automatics (21:00). Trusting some other network from the hotel must not touch it.
    after=0; if [[ -n "$man" ]] && is_trusted "$man"; then after=1; fi
    [[ "$before" == "$after" ]] || rm -f "$MANUAL"
    sync --connect
    ;;
  watch)
    valid_delay "${2:-5}" || { echo "watch [DELAY in seconds]" >&2; exit 1; }
    [[ -e "$MARK" ]] || exit 0
    systemctl is-active -q "$UNIT.service" && exit 0
    systemd-run -q --unit="$UNIT" --collect --description="VPN reconnect watchdog" /usr/local/bin/vpn-root reconnect "${2:-5}"
    ;;
  unwatch)
    systemctl stop "$UNIT.service" 2>/dev/null || true
    ;;
  reconnect)
    # Runs until the wanted connection is back up or the user says `vpn off` (marker gone).
    # The uplink stays shut the whole time, so nothing goes past the tunnel. The handshake itself is allowed by IP.
    valid_delay "${2:-5}" || { echo "reconnect [DELAY in seconds]" >&2; exit 1; }
    sleep "${2:-5}"   # after a switch via `vpn on xy` the new profile needs a moment before it reports "activating"; 0 from the dispatcher
    n=0
    while [[ -e "$MARK" ]]; do
      name=$(<"$MARK"); managed "$name" || exit 0
      table_loaded || ! systemctl is-active -q vpn-killswitch.service 2>/dev/null || load_rules || true   # a flushed ruleset must not leave us open while retrying (unless the unit was stopped on purpose)
      if managed_active >/dev/null; then exit 0; fi   # ours and really up; "activating" or a foreign VPN keeps us waiting
      (( n++ % 6 == 0 )) && log "tunnel down, trying $name (attempt $n)"
      uuid=$(vpn_uuid "$name")
      if valid_uuid "$uuid" && nmcli -w 40 con up uuid "$uuid" >/dev/null 2>&1; then log "$name reconnected"; exit 0; fi
      sleep 10
    done
    ;;
  auth)
    # Credentials as two lines on stdin, never as arguments: those would show up in `ps`.
    prov=${2:-}
    [[ $# -eq 2 ]] && valid_prov "$prov" || { echo "auth PROVIDER: username and password as two lines on stdin" >&2; exit 1; }
    install -d -m700 "$AUTHD"
    tmp=$(mktemp "$AUTHD/.auth.XXXXXX"); trap 'rm -f "$tmp"' EXIT   # mode 600 from the start, then renamed into place
    head -c 4097 > "$tmp"   # at most 4 KiB is read; a longer input is refused, never cut
    (( $(stat -c %s "$tmp") <= 4096 && $(wc -l < "$tmp") <= 2 )) || { echo "auth $prov: two lines of at most 4 KiB together on stdin" >&2; exit 1; }
    (( $(tr -d '\n\040-\176\200-\377' < "$tmp" | wc -c) == 0 )) || { echo "auth $prov: control characters in the credentials" >&2; exit 1; }
    u=$(sed -n 1p "$tmp"); p=$(sed -n 2p "$tmp")
    [[ -n "$u" && -n "$p" ]] || { echo "auth $prov: two non-empty lines on stdin, the username, then the password" >&2; exit 1; }
    printf '%s\n%s\n' "$u" "$p" > "$tmp"; mv "$tmp" "$AUTHD/$prov"
    echo "Credentials: $AUTHD/$prov"
    ;;
  add)
    # The config comes on stdin, never as a path. A root helper that opens a file its caller names reads whatever
    # that name points to by the time it opens it: a file swapped after the check, or a link to a file only root may
    # read. So root takes one copy of the bytes into a file of its own, and that copy is the only thing checked and
    # the only thing installed.
    name=${2:-}
    [[ $# -eq 2 ]] || { echo "add NAME: the config comes on stdin, as in: vpn-root add proton-ch < ch.protonvpn.udp.ovpn" >&2; exit 1; }
    valid_name "$name" || { echo "Name must be <provider>-<country>, lowercase, one dash: '$name'" >&2; exit 1; }
    prov=${name%%-*}
    [[ -f "$AUTHD/$prov" ]] || { echo "Credentials for '$prov' missing: vpn-root auth $prov first (two lines on stdin)" >&2; exit 1; }
    install -d -m755 "$CONF"
    new=$(mktemp "$CONF/.add.XXXXXX"); bak=""   # mode 600, and not *.ovpn, so no render or rebuild picks it up meanwhile
    # On any failure: no temp file stays, and credentials of a provider that has no profile left are forgotten, so the
    # wizard asks for them again instead of reporting them as stored with nothing to use them for.
    add_exit() {
      local rc=$?
      rm -f "$new" ${bak:+"$bak"}
      if (( rc != 0 )) && ! ls "$CONF"/"$prov"-*.ovpn >/dev/null 2>&1 && [[ -f "$AUTHD/$prov" ]]; then
        rm -f "$AUTHD/$prov"; echo "Credentials for '$prov' removed (no profile of this provider)" >&2
      fi
    }
    trap add_exit EXIT
    # after the trap: a refusal here also forgets the credentials of a provider with no profile
    if [[ ! -e "$CONF/$name.ovpn" ]] && (( $(find "$CONF" -maxdepth 1 -name '*.ovpn' | wc -l) >= MAX_PROFILES )); then
      echo "There are $MAX_PROFILES profiles already; remove one first" >&2; exit 1
    fi
    head -c $(( MAX_CONFIG + 1 )) > "$new"
    size=$(stat -c %s "$new")
    (( size > 0 && size <= MAX_CONFIG )) || { echo "The config on stdin is empty or larger than $MAX_CONFIG bytes" >&2; exit 1; }
    sed -i 's/\r$//' "$new"   # CRLF line ends are common in configs from Windows; stored with LF, so every check below sees plain lines
    grep -q '^remote ' "$new" || { echo "Not an OpenVPN config (no remote line)" >&2; exit 1; }
    # remote HOST [PORT [PROTO]]; without a port OpenVPN uses 1194, and so does the kill switch (render_rules)
    awk '$1=="remote"{print $2, $3}' "$new" | grep -qvE '^[A-Za-z0-9][A-Za-z0-9.-]* ?([0-9]{1,5})?$' && { echo "Unexpected remote host/port token in the config" >&2; exit 1; }
    why=$(config_problem "$new"); [[ -z "$why" ]] || { echo "The config $why." >&2; exit 1; }
    if awk '$1=="remote"{print $2}' "$new" | grep -qvE '^[0-9.]+$'; then
      echo "warning: this config names its servers by host name. The kill switch blocks DNS on a shut interface, so this profile can only connect from an open network (trusted Wi-Fi, or after vpn off). A config with IP addresses works everywhere." >&2
    fi
    [[ -f "$CONF/$name.ovpn" ]] && { bak=$(mktemp "$CONF/.bak.XXXXXX"); cp "$CONF/$name.ovpn" "$bak"; }
    mv "$new" "$CONF/$name.ovpn"; echo "Config: $CONF/$name.ovpn"
    if ! { render_rules && import_profile "$name"; }; then   # roll back so no orphan config poisons later rebuilds
      if [[ -n "$bak" ]]; then mv "$bak" "$CONF/$name.ovpn"; else rm -f "$CONF/$name.ovpn"; fi
      render_rules >/dev/null 2>&1 || true
      echo "Adding $name failed, config rolled back" >&2; exit 1
    fi
    [[ -n "$(get_setting default)" ]] || put_setting default "$name"   # the first profile becomes the default
    if [[ ! -e "$OPEN" && "$(get_setting killswitch)" != off ]]; then   # the first profile: the table could not be loaded at boot (no rules yet), so load it now
      systemctl start vpn-killswitch.service 2>/dev/null || true; [[ -e "$OPEN" ]] || load_rules || true; sync --connect
    fi
    log "profile $name added"
    ;;
  remove)
    name=${2:-}; [[ -n "$name" ]] || { echo "remove NAME" >&2; exit 1; }
    # Only profiles we imported: this runs as root without a password, so it must never be able to delete the
    # Wi-Fi connection or any other NM profile by name, and never a file outside configs/ (the name is a path piece).
    [[ "$name" =~ ^[a-z0-9]+-[a-z0-9]+$ ]] || { echo "Not a profile name: '$name'" >&2; exit 1; }
    managed "$name" || { echo "Not a tun0 VPN profile: '$name' (no $CONF/$name.ovpn)" >&2; exit 1; }
    if uuids=$(vpn_uuids "$name"); then
      for uuid in $uuids; do nmcli con delete uuid "$uuid" >/dev/null && echo "Profile deleted: $name"; done
    fi
    rm -f "$CONF/$name.ovpn"
    prov=${name%%-*}
    if ! ls "$CONF"/"$prov"-*.ovpn >/dev/null 2>&1 && [[ -f "$AUTHD/$prov" ]]; then   # last profile of this provider: forget its credentials
      rm -f "$AUTHD/$prov"; echo "Credentials for '$prov' removed (no profile left)"
    fi
    if [[ "$(get_setting default)" == "$name" ]]; then put_setting default "$(first_managed || true)"; fi   # the next profile becomes the default, so auto-connect keeps a target
    render_rules
    [[ -s "$RULES" ]] || do_unload   # nothing left to tunnel through: a table with no way out would only strand the user
    log "profile $name removed"
    ;;
  rebuild)
    [[ -z "${2:-}" ]] || valid_name "$2" || { echo "rebuild [NAME]" >&2; exit 1; }
    render_rules
    rc=0
    live=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="vpn"{print $1}')
    for f in "$CONF"/*.ovpn; do
      [[ -f "$f" ]] || continue
      n=$(basename "$f" .ovpn); [[ -z "${2:-}" || "$2" == "$n" ]] || continue
      if grep -qx "$n" <<<"$live"; then echo "Profile: $n (connected, left untouched, settings apply on next connect)"; continue; fi
      import_profile "$n" || { echo "Profile: $n FAILED" >&2; rc=1; }
    done
    exit $rc
    ;;
  has-auth)
    [[ "${2:-}" =~ ^[a-z0-9]+$ && -f "$AUTHD/$2" ]]   # provider names are [a-z0-9]+, nothing else reaches the file test
    ;;
  *)
    echo "Usage: vpn-root boot|unload|netevent pre-up|up|pre-down|down IFACE UUID|sync [--connect]|on [NAME]|arm NAME|off|status|watch [DELAY]|unwatch|reconnect [DELAY]|trust add|remove SSID|trust set|get KEY|set KEY VALUE|auth PROVIDER|add NAME|remove NAME|rebuild [NAME]|has-auth PROVIDER" >&2
    exit 2
    ;;
esac
